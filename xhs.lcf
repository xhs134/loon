[Rule]
# 局域网（原 Surge 内置 LAN 规则集，Loon 无内置，改为本地 IP 段直连）
IP-CIDR,192.168.10.0/24,home,no-resolve
IP-CIDR,192.168.0.0/16,DIRECT,no-resolve
IP-CIDR,10.0.0.0/8,DIRECT,no-resolve
IP-CIDR,172.16.0.0/12,DIRECT,no-resolve
IP-CIDR,127.0.0.0/8,DIRECT,no-resolve
# 封面拼接
DOMAIN-SUFFIX,pics.dmm.co.jp,F日本节点
DOMAIN-SUFFIX,awsimgsrc.dmm.co.jp,F日本节点
# 个人服务器走直连
DOMAIN-KEYWORD,tagss,DIRECT
# X / xAI-Grok（原 ddgksf2013 Ai.yaml 按用户要求仅保留 xAI/Grok 部分）
DOMAIN-SUFFIX,x.ai,X
DOMAIN-SUFFIX,grok.com,X
# Emby
DOMAIN-SUFFIX,cn2gias.uk,Emby
# 国内兜底
GEOIP,CN,DIRECT
FINAL,Final

